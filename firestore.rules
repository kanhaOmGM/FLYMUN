rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // =========================================================================
    // 1. System Configuration & Global Lock Switch (`systemConfig/munState`)
    // =========================================================================
    match /systemConfig/{docId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 2. User Profiles (`users/{userId}`) - Allows user onboarding & admin registration
    // =========================================================================
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 3. Claimed Seats (1-Person-Per-Seat Exclusivity & Admin Pre-assignment)
    // =========================================================================
    match /claimed_seats/{seatKey} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 4. Real-Time Committee Debate Timers (`committee_timers/{committeeId}`)
    // =========================================================================
    match /committee_timers/{committeeId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 5. General Speakers List (GSL) & Real-Time Hand Raises
    // =========================================================================
    match /committee_speakers/{speakerId} {
      allow read, write: if isAuthenticated();
    }

    match /committee_hands/{handId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 6. Committee Motions & Caucuses (`committee_motions/{motionId}`)
    // =========================================================================
    match /committee_motions/{motionId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 7. Voting Sessions & Resolution Engine (`voting_sessions/{sessionId}`)
    // =========================================================================
    match /voting_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // Generic Committee / Motion / Vote fallbacks
    match /committees/{committeeId} {
      allow read, write: if isAuthenticated();
    }

    match /motions/{motionId} {
      allow read, write: if isAuthenticated();
    }

    match /votes/{voteId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 8. Conference Photo Gallery & Pairing Invites
    // =========================================================================
    match /gallery_items/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /gallery_invites/{inviteId} {
      allow read, create, delete: if true;
      allow update: if false;
    }

    match /gallery/{imageId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 9. Contact Support & Feedback Submissions
    // =========================================================================
    match /feedback/{doc} {
      allow create: if isAuthenticated()
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 4001;
      allow read, update, delete: if false;
    }

    // =========================================================================
    // 10. Banned Emails & Custom Participants (Admin Management)
    // =========================================================================
    match /banned_emails/{emailKey} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /custom_participants/{partId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // 11. Default Deny for all other collections
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
