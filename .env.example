# =============================================================================
# FLY MUN Conference Platform — Environment Configuration (.env / Vercel Env)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Admin Security Passcode (For claiming Event Organiser role)
# -----------------------------------------------------------------------------
VITE_ADMIN_PASSCODE=FLY2026

# -----------------------------------------------------------------------------
# 2. Email Service Configuration (For Automated Roster Invitations)
# -----------------------------------------------------------------------------
# Option A: Resend API (Recommended for Vercel Serverless)
# Sign up at https://resend.com and generate an API key.
RESEND_API_KEY=re_your_api_key_here

# Option B: Standard SMTP Credentials (Optional alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_admin_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="FLY MUN <notifications@flymun.org>"

# -----------------------------------------------------------------------------
# 3. Portal Production URL
# -----------------------------------------------------------------------------
VITE_PORTAL_URL=https://flymun.vercel.app

# -----------------------------------------------------------------------------
# 4. Firebase Web App Configuration
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
